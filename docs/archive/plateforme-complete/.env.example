# Modèle des variables d'environnement.
# Copier ce fichier en .env.local et remplir les valeurs. Ne jamais publier .env.local.
# En ligne, les mêmes variables se mettent dans Vercel (Settings, Environment Variables).

# Adresse du site
NEXT_PUBLIC_SITE_URL=https://chaucase.pixanova.ca

# Stripe (clés de TEST au début)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_RATE_TPS=
STRIPE_TAX_RATE_TVQ=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (courriels)
RESEND_API_KEY=
EMAIL_FROM=reservations@pixanova.ca

# Administration
ADMIN_EMAILS=

# Interac (affiché à l'exposant)
INTERAC_EMAIL=paiements@pixanova.ca

# Tâches planifiées (rappels, libération des écrans)
CRON_SECRET=
