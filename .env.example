# Copier en .env (jamais publié). En ligne, ces variables vont dans Netlify :
# Project configuration > Environment variables.

# Stripe (clés de TEST au début : sk_test_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Taux de taxe exclusifs créés dans Stripe (identifiants txr_...)
STRIPE_TAX_RATE_TPS=
STRIPE_TAX_RATE_TVQ=

# Adresse publique du site (retour après paiement). En local : http://localhost:8888
SITE_URL=http://localhost:8888

# Le parc commun d’écrans se configure dans config/platform.json,
# jamais dans une variable par événement.

# Supabase Events : fondation en cours, ne pas activer avant installation et validation.
# Accès serveur uniquement. URL racine sans /rest/v1.
# SUPABASE_URL=https://REMPLACER.supabase.co
# SUPABASE_SECRET_KEY=
# INVENTORY_BACKEND=supabase
# CHECKOUT_PAUSED=true

# Facultatif : courriel d'alerte à chaque réservation (Resend). Sans ça, l'alerte va dans les journaux.
# RESEND_API_KEY=
# NOTIFY_FROM=reservations@pixanova.ca
# NOTIFY_TO=info@pixanova.ca
