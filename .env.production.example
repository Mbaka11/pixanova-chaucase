# MODÈLE des variables Netlify de PRODUCTION (contexte « Production » uniquement).
# Ne jamais mettre de vraies valeurs secrètes dans ce fichier : il est publié sur GitHub.
# Les identifiants txr_ ne sont pas secrets (ce sont des identifiants de taux de taxe).

# Clé API restreinte réelle créée dans Stripe (Developers > API keys > Create restricted key)
STRIPE_SECRET_KEY=rk_live_REMPLACER_DANS_NETLIFY

# Secret du webhook RÉEL (Workbench > Webhooks > votre destination > Click to reveal)
STRIPE_WEBHOOK_SECRET=whsec_REMPLACER_DANS_NETLIFY

# Taux de taxe RÉELS (exclusifs) : TPS 5 % et TVQ 9,975 %
STRIPE_TAX_RATE_TPS=txr_1UW7PBBMsNrAeWFfYvCEVqcY
STRIPE_TAX_RATE_TVQ=txr_1UW7PjBMsNrAeWFf2AcRTqDz

# Adresse publique finale, en HTTPS, sans barre oblique finale
SITE_URL=https://REMPLACER-PAR-LE-DOMAINE-FINAL

# Courriels d'équipe (Resend) : à configurer avant l'ouverture des ventes
RESEND_API_KEY=re_REMPLACER_DANS_NETLIFY
NOTIFY_FROM=reservations@pixanova.ca
NOTIFY_TO=info@pixanova.ca
